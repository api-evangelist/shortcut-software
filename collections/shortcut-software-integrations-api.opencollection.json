            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Generic Integration"
        },
        {
          "info": {
            "name": "Get Generic Integration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.app.shortcut.com/api/v3/integrations/webhook/:integration-public-id",
            "params": [
              {
                "name": "integration-public-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Generic Integration"
        },
        {
          "info": {
            "name": "Delete Generic Integration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.app.shortcut.com/api/v3/integrations/webhook/:integration-public-id",
            "params": [
              {
                "name": "integration-public-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Generic Integration"
        }
      ]
    }
  ],
  "bundled": true
}