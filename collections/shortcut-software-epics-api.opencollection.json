          "http": {
            "method": "POST",
            "url": "https://api.app.shortcut.com/api/v3/epics/:epic-public-id/comments/:comment-public-id",
            "params": [
              {
                "name": "epic-public-id",
                "value": "",
                "type": "path",
                "description": "The ID of the associated Epic."
              },
              {
                "name": "comment-public-id",
                "value": "",
                "type": "path",
                "description": "The ID of the parent Epic Comment."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint allows you to create a nested Comment reply to an existing Epic Comment."
        },
        {
          "info": {
            "name": "Update Epic Comment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.app.shortcut.com/api/v3/epics/:epic-public-id/comments/:comment-public-id",
            "params": [
              {
                "name": "epic-public-id",
                "value": "",
                "type": "path",
                "description": "The ID of the associated Epic."
              },
              {
                "name": "comment-public-id",
                "value": "",
                "type": "path",
                "description": "The ID of the Comment."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint allows you to update a threaded Comment on an Epic."
        },
        {
          "info": {
            "name": "Delete Epic Comment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.app.shortcut.com/api/v3/epics/:epic-public-id/comments/:comment-public-id",
            "params": [
              {
                "name": "epic-public-id",
                "value": "",
                "type": "path",
                "description": "The ID of the associated Epic."
              },
              {
                "name": "comment-public-id",
                "value": "",
                "type": "path",
                "description": "The ID of the Comment."
              }
            ]
          },
          "docs": "This endpoint allows you to delete a Comment from an Epic."
        },
        {
          "info": {
            "name": "List Epic Documents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.app.shortcut.com/api/v3/epics/:epic-public-id/documents",
            "params": [
              {
                "name": "epic-public-id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the Epic."
