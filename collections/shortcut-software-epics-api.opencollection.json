          },
          "http": {
            "method": "POST",
            "url": "https://api.app.shortcut.com/api/v3/epics/:epic-public-id/comments",
            "params": [
              {
                "name": "epic-public-id",
                "value": "",
                "type": "path",
                "description": "The ID of the associated Epic."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint allows you to create a threaded Comment on an Epic."
