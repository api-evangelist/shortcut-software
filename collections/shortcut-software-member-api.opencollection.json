{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shortcut Categories Member API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Shortcut-Token",
      "value": "{{Shortcut-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Member",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Current Member Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.app.shortcut.com/api/v3/member"
          },
          "docs": "Returns information about the authenticated member."
        }
      ]
    }
  ],
  "bundled": true
}