{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shortcut Categories Repositories API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Shortcut-Token",
      "value": "{{Shortcut-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Repositories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Repositories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.app.shortcut.com/api/v3/repositories"
          },
          "docs": "List Repositories returns a list of all Repositories and their attributes."
        },
        {
          "info": {
            "name": "Get Repository",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.app.shortcut.com/api/v3/repositories/:repo-public-id",
            "params": [
              {
                "name": "repo-public-id",
                "value": "",
                "type": "path",
                "description": "The unique ID of the Repository."
              }
            ]
          },
          "docs": "Get Repository returns information about the selected Repository."
        }
      ]
    }
  ],
  "bundled": true
}